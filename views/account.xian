{{> workspace-start}}
<div class="page-heading"><div><p class="eyebrow">YOUR KAMBAC IDENTITY</p><h1>My account</h1><p>Your profile and workspace access, in one place.</p></div></div>
<div class="account-layout"><section class="panel profile-summary"><span class="avatar profile-avatar">{{account.initials}}</span><h2>{{account.name}}</h2><span class="badge role-badge">{{account.role}}</span><p>KAMBAC registered member</p></section><section class="panel profile-details"><div class="section-heading"><h2>Account information</h2><span class="read-only-label">Read only</span></div><dl><div><dt>Full name</dt><dd>{{account.name}}</dd></div><div><dt>Email address</dt><dd>{{account.email}}</dd></div><div><dt>Account ID</dt><dd>#{{account.id}}</dd></div><div><dt>Workspace role</dt><dd class="capitalize">{{account.role}}</dd></div></dl><div class="account-permissions">{{> icon name="shield"}}<div><h3>{{#if canPost}}Announcement management{{else}}Announcement viewing{{/if}}</h3><p>{{#if canPost}}You can create and publish announcements, and edit, archive or remove only your own updates.{{else}}You can read published announcements shared with you and manage your own notification read status.{{/if}}</p></div></div><p class="field-help">Account details and role changes are managed by your authorized administrator. Your password is never displayed here.</p><a class="button secondary" href="/logout">{{> icon name="logout"}}Sign out</a></section></div>
{{> workspace-end}}
