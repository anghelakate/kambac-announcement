{{> workspace-start}}
<a class="back-link" href="/announcements">&larr; Back to announcements</a>
<div class="detail-layout"><article class="panel announcement-detail"><div class="card-labels"><span class="badge {{announcement.displayStatus}}"><span></span>{{announcement.displayStatus}}</span><span class="audience-label">{{announcement.audienceLabel}}</span></div><h1>{{announcement.title}}</h1><div class="detail-author"><span class="avatar">{{announcement.authorInitials}}</span><div><strong>{{announcement.authorName}}</strong><p>{{#if announcement.publishedLabel}}Published {{announcement.publishedLabel}}{{else}}Created {{announcement.dateLabel}}{{/if}}</p></div></div><div class="announcement-body">{{announcement.content}}</div></article><aside><section class="panel detail-sidebar"><h2>About this announcement</h2><dl><div><dt>Audience</dt><dd>{{announcement.audienceLabel}}</dd></div><div><dt>Created</dt><dd>{{announcement.dateLabel}}</dd></div><div><dt>First published</dt><dd>{{#if announcement.publishedLabel}}{{announcement.publishedLabel}}{{else}}Not published yet{{/if}}</dd></div><div><dt>Status</dt><dd class="capitalize">{{announcement.displayStatus}}</dd></div></dl>{{#if announcement.canManage}}<a class="button full-width" href="/announcements/{{announcement.id}}/edit">{{> icon name="edit"}}Edit announcement</a><form method="POST" action="/announcements/{{announcement.id}}/{{#if announcement.archivedAt}}restore{{else}}archive{{/if}}"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="button secondary full-width">{{> icon name="archive"}}{{#if announcement.archivedAt}}Restore announcement{{else}}Archive announcement{{/if}}</button></form>{{/if}}</section><p class="sidebar-caption">Only the original Admin poster can manage this announcement.</p></aside></div>
{{> workspace-end}}
