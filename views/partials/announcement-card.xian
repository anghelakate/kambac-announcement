<article class="announcement-card"><div class="card-topline"><div class="card-labels"><span class="badge {{displayStatus}}"><span></span>{{displayStatus}}</span><span class="audience-label">{{audienceLabel}}</span></div><span class="card-date">{{dateLabel}}</span></div><h2><a href="/announcements/{{id}}">{{title}}</a></h2><p class="announcement-excerpt">{{excerpt}}</p><div class="card-bottom"><span class="author"><span class="avatar tiny">{{authorInitials}}</span><span>{{authorName}}</span></span><a class="text-link" href="/announcements/{{id}}">Read announcement {{> icon name="arrow"}}</a></div>{{#if canManage}}<div class="management-actions"><a href="/announcements/{{id}}/edit">{{> icon name="edit"}}Edit</a><form method="POST" action="/announcements/{{id}}/{{#if archivedAt}}restore{{else}}archive{{/if}}"><input type="hidden" name="_csrf" value="{{@root.csrf}}"><button type="submit">{{> icon name="archive"}}{{#if archivedAt}}Restore{{else}}Archive{{/if}}</button></form><form method="POST" action="/announcements/{{id}}/delete" data-confirm-delete><input type="hidden" name="_csrf" value="{{@root.csrf}}"><button type="submit" class="delete-action">Remove</button></form></div>{{/if}}</article>
