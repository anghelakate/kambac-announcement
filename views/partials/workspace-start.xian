<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#0B0E13"><title>{{title}} | KAMBAC Announcements</title><link rel="stylesheet" href="/announcements.css"><script src="/workspace.js" defer></script><script src="/announcement-form.js" defer></script><link rel="icon" href="/favicon.svg" type="image/svg+xml"></head>
<body class="announcement-app"><a class="skip-link" href="#main-content">Skip to content</a>
<div class="sidebar-backdrop" data-close-sidebar hidden></div>
<aside class="sidebar" id="workspace-sidebar" aria-label="Main navigation">
<a class="brand" href="/dashboard"><span class="brand-mark">K<span>.</span></span><span><strong>KAMBAC</strong><small>Announcement System</small></span></a>
<div class="sidebar-section-label">WORKSPACE</div><nav class="sidebar-nav">
<a href="/dashboard" class="{{#if activeDashboard}}active{{/if}}" {{#if activeDashboard}}aria-current="page"{{/if}}>{{> icon name="grid"}}<span>Overview</span></a>
<a href="/announcements" class="{{#if activeAnnouncements}}active{{/if}}" {{#if activeAnnouncements}}aria-current="page"{{/if}}>{{> icon name="announce"}}<span>Announcements</span></a>
<a href="/notifications" class="{{#if activeNotifications}}active{{/if}}" {{#if activeNotifications}}aria-current="page"{{/if}}>{{> icon name="bell"}}<span>Notifications</span>{{#if unreadCount}}<span class="nav-count">{{unreadCount}}</span>{{/if}}</a>
</nav><div class="sidebar-section-label account-label">PERSONAL</div><nav class="sidebar-nav"><a href="/account" class="{{#if activeAccount}}active{{/if}}" {{#if activeAccount}}aria-current="page"{{/if}}>{{> icon name="user"}}<span>My account</span></a></nav>
<div class="sidebar-bottom"><div class="workspace-note"><span class="status-dot"></span><span>Your cooperative, connected.<small>One place for every update.</small></span></div><a class="sidebar-user" href="/account"><span class="avatar">{{account.initials}}</span><span class="user-copy"><strong>{{account.name}}</strong><small>{{account.role}}</small></span>{{> icon name="chevron"}}</a></div></aside>
<div class="workspace"><header class="topbar"><div class="topbar-left"><button class="icon-button mobile-menu" type="button" aria-label="Open navigation" aria-controls="workspace-sidebar" aria-expanded="false" data-toggle-sidebar>{{> icon name="menu"}}</button><span class="breadcrumb">Workspace <span>/</span> <strong>{{title}}</strong></span></div><div class="topbar-right"><a class="notification-shortcut icon-button" href="/notifications" aria-label="Notifications{{#if unreadCount}}, {{unreadCount}} unread{{/if}}">{{> icon name="bell"}}{{#if unreadCount}}<span class="unread-dot"></span>{{/if}}</a><span class="topbar-divider"></span><details class="account-menu"><summary><span class="avatar small">{{account.initials}}</span><span class="user-copy"><strong>{{account.name}}</strong><small>{{account.role}}</small></span>{{> icon name="chevron"}}</summary><div class="account-dropdown"><span class="dropdown-label">SIGNED IN AS</span><strong>{{account.name}}</strong><a href="/account">{{> icon name="user"}}My account</a><a href="/logout">{{> icon name="logout"}}Sign out</a></div></details></div></header>
<main class="main-content" id="main-content">
{{#if success_msg}}<div class="alert success" role="status">{{> icon name="check"}}<span>{{success_msg}}</span></div>{{/if}}
{{#if error_msg}}<div class="alert error" role="alert"><span>{{error_msg}}</span></div>{{/if}}
