<div class="stats-grid">
<a class="stat-card" href="/announcements?status=all"><span class="stat-label">Total announcements <span class="stat-icon">{{> icon name="announce"}}</span></span><strong>{{summary.total}}</strong><span class="stat-caption">Available in your workspace</span></a>
<a class="stat-card" href="/announcements?status=published"><span class="stat-label">Published <span class="stat-icon green">{{> icon name="check"}}</span></span><strong>{{summary.published}}</strong><span class="stat-caption"><span class="tiny-dot green"></span> Shared with their audience</span></a>
{{#if canPost}}<a class="stat-card" href="/announcements?status=draft"><span class="stat-label">Your drafts <span class="stat-icon amber">{{> icon name="edit"}}</span></span><strong>{{summary.drafts}}</strong><span class="stat-caption">Ready when you are</span></a>{{else}}<a class="stat-card" href="/account"><span class="stat-label">Your access <span class="stat-icon amber">{{> icon name="shield"}}</span></span><strong class="stat-word">View only</strong><span class="stat-caption">Announcements shared with you</span></a>{{/if}}
<a class="stat-card" href="/notifications?filter=unread"><span class="stat-label">Unread notifications <span class="stat-icon amber">{{> icon name="bell"}}</span></span><strong>{{summary.unread}}</strong><span class="stat-caption">{{#if summary.unread}}Updates waiting for you{{else}}You're all caught up{{/if}}</span></a>
</div>
