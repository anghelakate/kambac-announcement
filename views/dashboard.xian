{{> workspace-start}}
<div class="page-heading"><div><p class="eyebrow">YOUR WORKSPACE AT A GLANCE</p><h1>Workspace overview</h1><p>The latest updates, all in one place.</p></div><span class="date-chip">{{> icon name="clock"}}{{today}}</span></div>
{{> workspace-stats}}
<section class="welcome-banner"><div class="banner-symbol">{{> icon name="announce"}}</div><div><h2>{{#if canPost}}Keep your community in the loop.{{else}}Stay informed. Stay connected.{{/if}}</h2><p>{{#if canPost}}Share an update, prepare a draft, or manage your announcements.{{else}}Find the announcements and updates shared with you.{{/if}}</p></div><a class="button {{#unless canPost}}secondary{{/unless}}" href="{{#if canPost}}/announcements/new{{else}}/announcements{{/if}}">{{#if canPost}}{{> icon name="plus"}}Create announcement{{else}}Browse announcements{{> icon name="arrow"}}{{/if}}</a></section>
<div class="dashboard-columns"><section><div class="section-heading"><h2>Latest announcements <span class="subtle-count">{{summary.published}}</span></h2><a class="text-link" href="/announcements">View all {{> icon name="arrow"}}</a></div><div class="card-list">{{#each recentAnnouncements}}{{> announcement-card}}{{else}}<div class="empty-state panel"><span class="empty-icon">{{> icon name="announce"}}</span><h3>No updates just yet</h3><p>Published announcements shared with you will appear here.</p><a class="button secondary" href="/announcements">View announcements</a></div>{{/each}}</div></section><aside><div class="section-heading"><h2>Your inbox</h2><a class="text-link" href="/notifications">View all</a></div><div class="panel inbox-preview">{{#each recentNotifications}}<form method="POST" action="/notifications/{{id}}/open" class="inbox-item"><input type="hidden" name="_csrf" value="{{@root.csrf}}"><span class="inbox-symbol {{#if unread}}is-unread{{/if}}">{{> icon name="bell"}}</span><button type="submit"><strong>{{title}}</strong><span>{{dateLabel}} &middot; {{#if unread}}Unread{{else}}Read{{/if}}</span></button></form>{{else}}<div class="mini-empty">{{> icon name="check"}}<h3>You're all caught up</h3><p>Your notifications will appear here.</p></div>{{/each}}</div><div class="workspace-tip"><span class="tip-icon">{{> icon name="shield"}}</span><h3>Your workspace, your access</h3><p>{{#if canPost}}Only you can edit, archive or remove the announcements you create.{{else}}You can read published updates shared with you. Your account is view-only.{{/if}}</p><a class="text-link" href="/account">View my account {{> icon name="arrow"}}</a></div></aside></div>
{{> workspace-end}}
