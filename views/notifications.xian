{{> workspace-start}}
<div class="page-heading"><div><p class="eyebrow">YOUR COMMUNITY INBOX</p><h1>Notifications</h1><p>Follow the updates shared with you. Opening an update marks it as read.</p></div><span class="unread-pill">{{unreadCount}} unread</span></div>
<section class="panel notification-panel"><div class="tabs"><a href="/notifications" class="{{#unless unreadOnly}}active{{/unless}}">All notifications <span>{{notificationTotal}}</span></a><a href="/notifications?filter=unread" class="{{#if unreadOnly}}active{{/if}}">Unread <span>{{unreadCount}}</span></a></div><div class="notification-list">{{#each notifications}}<article class="notification-row {{#if unread}}is-unread{{/if}}"><span class="notification-symbol">{{> icon name="announce"}}</span><div class="notification-copy"><div class="notification-kicker">ANNOUNCEMENT <span class="badge {{#if unread}}published{{else}}read{{/if}}">{{#if unread}}Unread{{else}}Read{{/if}}</span></div><h2>{{title}}</h2><p>{{authorName}} <span>&middot;</span> {{dateLabel}}</p></div><form method="POST" action="/notifications/{{id}}/open"><input type="hidden" name="_csrf" value="{{@root.csrf}}"><button class="button secondary compact" type="submit">Open update {{> icon name="arrow"}}</button></form></article>{{else}}<div class="empty-state"><span class="empty-icon">{{> icon name="bell"}}</span><h3>{{#if unreadOnly}}You're all caught up{{else}}Your inbox is ready{{/if}}</h3><p>{{#if unreadOnly}}You have no unread updates.{{else}}When a published announcement is shared with you, its notification will appear here.{{/if}}</p><a class="button secondary" href="{{#if unreadOnly}}/notifications{{else}}/announcements{{/if}}">{{#if unreadOnly}}View all notifications{{else}}Browse announcements{{/if}}</a></div>{{/each}}</div></section>
{{> workspace-end}}
