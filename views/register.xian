{{> auth-start}}<section class="panel auth-card"><p class="eyebrow">JOIN YOUR COMMUNITY</p><h1>A place to stay connected.</h1><p class="auth-description">Create your account to read announcements shared with KAMBAC members.</p>{{#if formError}}<div class="alert error" role="alert">{{formError}}</div>{{/if}}<form method="POST" action="/register"><label for="register-name">Full name</label><input id="register-name" name="name" value="{{name}}" placeholder="Your full name" autocomplete="name" required><label for="register-email">Email address</label><input id="register-email" type="email" name="email" value="{{email}}" placeholder="you@example.com" autocomplete="username" required><label for="register-password">Password</label><input id="register-password" type="password" name="password" placeholder="Choose a password" autocomplete="new-password" required><p class="field-help">New accounts receive view-only access. Your organization manages role assignments.</p><button class="button full-width" type="submit">Create account {{> icon name="arrow"}}</button></form><p class="auth-switch">Already registered? <a href="/login">Sign in</a></p></section>{{> auth-end}}
