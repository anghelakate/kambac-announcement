{{> workspace-start}}
<div class="page-heading"><div><p class="eyebrow">COMMUNITY UPDATES</p><h1>Announcements</h1><p>Important news and updates for the KAMBAC community.</p></div>{{#if canPost}}<a class="button" href="/announcements/new">{{> icon name="plus"}}Create announcement</a>{{/if}}</div>
{{> workspace-stats}}
<section class="panel announcements-panel"><div class="panel-toolbar"><div><h2>Announcement directory</h2><p>{{pagination.total}} {{#if (eq pagination.total 1)}}announcement{{else}}announcements{{/if}} match your access and filters</p></div><span class="directory-tag">{{#if canPost}}Manage &amp; discover{{else}}Community bulletin{{/if}}</span></div>
<form method="GET" action="/announcements" class="filters"><label class="search-field"><span class="sr-only">Search announcements</span>{{> icon name="search"}}<input type="search" name="q" value="{{q}}" maxlength="255" placeholder="Search titles or announcement details..."></label><label class="status-field"><span class="sr-only">Filter by status</span><select name="status" aria-label="Filter by status"><option value="">{{#if canPost}}All active statuses{{else}}All published updates{{/if}}</option><option value="published" {{#if (eq filterStatus 'published')}}selected{{/if}}>Published</option>{{#if canPost}}<option value="all" {{#if (eq filterStatus 'all')}}selected{{/if}}>All announcements</option><option value="draft" {{#if (eq filterStatus 'draft')}}selected{{/if}}>Drafts</option><option value="archived" {{#if (eq filterStatus 'archived')}}selected{{/if}}>Archived</option>{{/if}}</select></label><button class="button secondary" type="submit">Apply filters</button>{{#if hasFilters}}<a class="text-link clear-filter" href="/announcements">Clear</a>{{/if}}</form>
<div class="directory-summary"><span>{{#if hasFilters}}Filtered results{{else}}Latest first{{/if}}</span><span>Showing {{pagination.start}}&ndash;{{pagination.end}} of {{pagination.total}}</span></div>
<div class="announcement-grid">{{#each announcements}}{{> announcement-card}}{{else}}<div class="empty-state"><span class="empty-icon">{{> icon name="search"}}</span><h3>{{#if hasFilters}}No matching announcements{{else}}A fresh start for your community{{/if}}</h3><p>{{#if hasFilters}}Try a different search term or clear your filters.{{else}}{{#if canPost}}Create your first announcement or save an update as a draft.{{else}}There are no published announcements shared with you yet. Check back for the next update.{{/if}}{{/if}}</p>{{#if hasFilters}}<a class="button secondary" href="/announcements">Clear filters</a>{{else}}{{#if canPost}}<a class="button" href="/announcements/new">{{> icon name="plus"}}Create announcement</a>{{/if}}{{/if}}</div>{{/each}}</div>
{{#if showPagination}}<nav class="pagination" aria-label="Announcement pagination"><span>Page {{pagination.page}} of {{pagination.pages}}</span><div>{{#if pagination.hasPrevious}}<a class="button secondary" href="{{previousPage}}">Previous</a>{{else}}<span class="button secondary disabled" aria-disabled="true">Previous</span>{{/if}}{{#if pagination.hasNext}}<a class="button secondary" href="{{nextPage}}">Next {{> icon name="arrow"}}</a>{{else}}<span class="button secondary disabled" aria-disabled="true">Next</span>{{/if}}</div></nav>{{/if}}</section>
{{> workspace-end}}
